# 服务器配置
PORT=3000
HOST=0.0.0.0

# API 配置
API_KEY_REQUIRED=true
API_KEY=your-api-key-here

# TTS 配置
TTS_VOICE=Yue
TTS_OUTPUT_FORMAT=mp3
TTS_TEMP_DIR=/tmp/miniAiApi

# TTS 标准模型配置（不克隆）
TTS_MODEL_ENABLED=false
TTS_MODEL_ALIAS=tts-1:model
TTS_MODEL_NAME=mlx-community/Qwen3-TTS-12Hz-0.6B-Base-bf16
TTS_MODEL_LOCAL_PATH=/Users/easy/.cache/huggingface/hub/models--mlx-community--Qwen3-TTS-12Hz-0.6B-Base-bf16/snapshots/1eccf1cb2519b5a4e8a95b5f0544f3303568164f
TTS_MODEL_DEFAULT_VOICE_ZH=Vivian
TTS_MODEL_DEFAULT_VOICE_EN=Ryan

# TTS 音频克隆配置
TTS_CLONE_ENABLED=false
TTS_CLONE_MODEL=mlx-community/Spark-TTS-0.5B-16bf
TTS_CLONE_REF_AUDIO=/path/to/reference/audio.mp3
TTS_CLONE_REF_TEXT=参考音频对应的文本内容
TTS_CLONE_LANG_CODE=z
TTS_CLONE_SPEED=1.0

# STT 配置
STT_MODEL=mlx-community/whisper-large-v3-mlx
STT_LANGUAGE=zh
STT_OUTPUT_DIR=/tmp/whisper_output

# 日志配置
LOG_LEVEL=info

# LMstudio 配置
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_API_KEY=
LMSTUDIO_TIMEOUT=60000

# Draw Things 配置
DRAW_THINGS_BASE_URL=http://127.0.0.1:7860
DRAW_THINGS_ENABLED=false
DRAW_THINGS_TIMEOUT=120000

# 代理配置
# 是否启用系统代理用于外部服务请求（默认关闭，本地服务永远不使用代理）
LOCAL_PROXY_ENABLED=false
